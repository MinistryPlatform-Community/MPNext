# =============================================================================
# Better Auth Configuration
# =============================================================================
# Better Auth handles user authentication via OAuth against Ministry Platform.
# Docs: https://www.better-auth.com/docs
#
#
# OIDC_CLIENT_ID / SECRET are used ONLY for end-user sign-in. Use a DEDICATED
# Ministry Platform API Client for MPNext (Administration > API Clients):
#
#   - Authentication flow: Authorization Code ONLY. Do not enable Implicit,
#     Hybrid or Resource Owner (password) on this client.
#   - Redirect URIs: exactly {BETTER_AUTH_URL}/api/auth/callback/ministry-platform
#     for each environment - no wildcards, no extra entries.
#   - Post-logout redirect URIs: {BETTER_AUTH_URL} for each environment.
#
# Do NOT reuse a shared client such as TM.Widgets. Ministry Platform does not
# support PKCE, so a dedicated confidential client with exact redirect URIs is
# the main defence against authorization-code injection; a shared client, or
# one that allows implicit/hybrid flows, widens what an attacker can replay
# (see docs/security/2026-09-25-signin-hardening.md). Keep the secret private.
#
# The server-side data client (MINISTRY_PLATFORM_CLIENT_ID below) should be a
# SEPARATE API Client.
OIDC_CLIENT_ID=MPNext
OIDC_CLIENT_SECRET=

# Secret used by Better Auth for signing session cookies and tokens.
# Must be at least 32 characters with high entropy - the app refuses to start
# otherwise. Generate one with:  openssl rand -base64 32
# If you type a value by hand, wrap it in double quotes and write each $ as \$
# (unquoted, Next's env loader treats # as a comment and expands $NAME, so
# Xy9$Qz7Lm#Kp2... loads as "Xy9"). `npm run setup:check` reports the length
# the app will actually see.
# Fallback: NEXTAUTH_SECRET (for migrating from NextAuth)
BETTER_AUTH_SECRET=

# Base URL of this application (used for OAuth callback URLs, etc.)
# Update to match your production environment.
# Fallback: NEXTAUTH_URL (for migrating from NextAuth)
BETTER_AUTH_URL=http://localhost:3000

# Client IP for sign-in rate limiting (production only: /sign-in* allows 3
# requests per 10 s per client IP). By default better-auth trusts only a
# single, valid IP in x-forwarded-for. If your host sends anything else (no
# header, an appended chain, or "ip:port"), EVERY client shares one bucket and
# a few requests block sign-in for everyone - the server logs a one-time
# "could not determine a client IP" warning when this happens.
#
# Only name a header your edge always OVERWRITES. A header clients can set
# themselves lets them bypass the limit, or lock someone else's IP out.
# Verify on your host before relying on these:
#
#   Vercel ............ leave blank (Vercel overwrites x-forwarded-for), or x-real-ip
#   Cloudflare ........ AUTH_IP_ADDRESS_HEADERS=cf-connecting-ip
#   Azure App Service . AUTH_IP_ADDRESS_HEADERS=x-client-ip  (x-forwarded-for has ip:port)
#   nginx / other proxy appending to x-forwarded-for:
#                       AUTH_TRUSTED_PROXIES=<your proxy IPs or CIDRs>
#   next start exposed directly: no trustworthy header - put a proxy in front
#
# Both are comma-separated. Invalid entries refuse startup.
AUTH_IP_ADDRESS_HEADERS=
AUTH_TRUSTED_PROXIES=

# =============================================================================
# MinistryPlatform API Configuration
# =============================================================================
# This API Client / Secret is used for ALL server-side data access (including
# the security-role gate) and is the user for audit log data when no userId is
# provided. Use a SEPARATE API Client from OIDC_CLIENT_ID above:
#
#   - Authentication flow: Client Credentials ONLY.
#   - Client User: a dedicated, least-privilege MP user. Every server-side read
#     and write runs with that user's permissions.
#   - No redirect URIs needed.
MINISTRY_PLATFORM_CLIENT_ID=MPNext.API
MINISTRY_PLATFORM_CLIENT_SECRET=
MINISTRY_PLATFORM_BASE_URL=https://mpi.ministryplatform.com/ministryplatformapi

# =============================================================================
# Authorization
# =============================================================================
# REQUIRED for the contact features to work. Comma-separated Ministry Platform
# security role names permitted to use the contact-lookup and contact-log
# features (reads AND writes), e.g.:
#
#   MP_SECURITY_ROLES="Administrators,Pastoral Staff"
#
# Comparison is case- and whitespace-insensitive.
#
# The gate FAILS CLOSED. Unset, blank, or a value naming no roles (e.g. ",")
# permits NOBODY: every signed-in user is redirected to /no-access on the gated
# pages, and the server logs an "mp.authz.config" warning once. To permit any
# user who holds at least one MP security role, opt in explicitly with:
#
#   MP_SECURITY_ROLES=*
#
# ("*" must be the whole value; inside a list it is not a wildcard.) Think
# before choosing "*": it includes roles like check-in or kiosk accounts, and
# every pastoral note becomes readable to them.
#
# Deprecated fallback: MP_WRITE_SECURITY_ROLES, the write-only predecessor of
# this variable. It is still read when MP_SECURITY_ROLES yields no usable value
# (so an existing deployment keeps working), but it now governs reads as well,
# and MP_SECURITY_ROLES wins where both are set. New deployments should set
# only MP_SECURITY_ROLES.
#
# See .claude/references/auth.md for the full policy.
MP_SECURITY_ROLES=

# =============================================================================
# NEXT Public Keys
# =============================================================================
NEXT_PUBLIC_MINISTRY_PLATFORM_FILE_URL=https://mpi.ministryplatform.com/ministryplatformapi/files
NEXT_PUBLIC_APP_NAME=MPNextApp

# =============================================================================
# Security Headers
# =============================================================================
# Drops the Content-Security-Policy back to report-only. Normally leave blank.
#
# The policy in src/lib/security-headers.ts is applied by src/proxy.ts with a
# fresh per-request nonce, and it ENFORCES by default. Only the exact string
# "false" backs off to report-only; anything else, including unset, enforces.
# The escape hatch is inverted on purpose - a typo here fails loud (too strict)
# rather than silent (no policy at all).
#
# Set this to "false" only to diagnose a violation: the browser then reports
# what the policy WOULD have blocked, in the console, without breaking the page.
# Be aware report-only does not catch everything - a runtime-injected <style>
# that enforcement blocks was NOT reported in report-only mode (2026-09-12).
#
# If you change the policy, re-walk the app against a PRODUCTION build with
# devtools open - dev has deliberate relaxations that hide violations. Cover
# sign-in, sign-out, contact photos, and every Radix surface (dropdown, dialog,
# select, tooltip, drawer).
CSP_ENFORCE=
